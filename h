/* ═══════════════════════════════════════════════════════
   ДВИЖОК
═══════════════════════════════════════════════════════ */
let ST = JSON.parse(localStorage.getItem("hogRus3")||'{"pts":0,"done":[],"streak":0,"lastDate":"","sec":0}');
let curDay=0, curQ=0, correct=0;
const save = ()=>localStorage.setItem("hogRus3",JSON.stringify(ST));
const norm = s=>s.toLowerCase().trim().replace(/ё/g,"е").replace(/\s+/g," ");

const secDays = ()=>DAYS.map((d,i)=>({...d,idx:i})).filter(d=>d.sec===ST.sec);

function updHdr(){
  document.getElementById("stars").textContent=ST.pts;
  document.getElementById("streak").textContent=ST.streak;
}

function renderTabs(){
  const el=document.getElementById("tabs"); el.innerHTML="";
  SEC.forEach((s,i)=>{
    const b=document.createElement("button");
    b.className="tab"+(i===ST.sec?" active":"");
    b.dataset.s=i; b.textContent=s.name;
    b.onclick=()=>{ST.sec=i;save();curDay=0;curQ=0;correct=0;renderTabs();renderDays();renderQ();};
    el.appendChild(b);
  });
}

function renderDays(){
  const el=document.getElementById("days"); el.innerHTML="";
  secDays().forEach((d,i)=>{
    const b=document.createElement("button");
    b.className="day-btn"+(ST.done.includes(d.idx)?" done":"")+(i===curDay?" active":"");
    b.textContent=(ST.done.includes(d.idx)?"✅":"")+(i+1);
    b.onclick=()=>{curDay=i;curQ=0;correct=0;renderDays();renderQ();};
    el.appendChild(b);
  });
}

function setProg(){
  const days=secDays(); const day=days[curDay]; if(!day)return;
  document.getElementById("prog").style.width=Math.round((curQ/day.questions.length)*100)+"%";
}

const STAGE_META={
  rule:     {cls:"stage-rule",     label:"📖 Правило"},
  practice: {cls:"stage-practice", label:"⚡ Практика"},
  exception:{cls:"stage-exception",label:"🔥 Исключение"},
  olymp:    {cls:"stage-olymp",    label:"🏆 Олимпиада"},
};

function award(fb,ok,show,fact,card){
  if(ok){
    fb.textContent="🎉 Верно! +1 ⚡"; fb.style.color="var(--ok)";
    ST.pts++; correct++; save(); updHdr();
    card.classList.add("flash-ok"); setTimeout(()=>card.classList.remove("flash-ok"),600);
  } else {
    fb.textContent="Не беда, запомним! 💪"; fb.style.color="var(--err)";
    card.classList.add("flash-err"); setTimeout(()=>card.classList.remove("flash-err"),500);
    if(show){const h=document.createElement("div");h.className="hint-ans";h.textContent="Ответ: "+show;fb.after(h);}
  }
  if(fact){
    const f=document.createElement("div");f.className="fun-fact";f.textContent=fact;
    card.querySelector(".options,input")?.after?.(f) || card.appendChild(f);
  }
}

function addNext(card){
  const b=document.createElement("button");b.className="next-btn";b.textContent="Дальше →";
  b.onclick=()=>{curQ++;setProg();renderQ();};card.appendChild(b);
}

function renderQ(){
  setProg();
  const days=secDays(); const day=days[curDay]; if(!day)return;
  if(curQ>=day.questions.length){renderResult();return;}
  const item=day.questions[curQ];
  const sec=SEC[day.sec];
  const card=document.getElementById("card");
  const sm=STAGE_META[item.stage]||STAGE_META.practice;

  // Если это "rule" — особый рендер
  if(item.stage==="rule"){
    card.innerHTML=`
      <div class="mascot">${sec.emoji}</div>
      <div class="q-meta">${day.title} · вопрос ${curQ+1}/${day.questions.length}</div>
      <span class="stage-badge ${sm.cls}">${sm.label}</span>
      <div class="scroll-box">
        <div class="scroll-title">Заклинание дня</div>
        <div class="scroll-body">${item.q}</div>
      </div>`;
    const b=document.createElement("button");b.className="rule-btn";
    b.textContent="Понял! Вперёд →";
    b.onclick=()=>{curQ++;setProg();renderQ();};
    card.appendChild(b);
    return;
  }

  let html=`<div class="mascot">${sec.emoji}</div>
    <div class="q-meta">${day.title} · вопрос ${curQ+1}/${day.questions.length}</div>
    <span class="stage-badge ${sm.cls}">${sm.label}</span>`;
  if(item.ctx) html+=`<div class="ctx">${item.ctx}</div>`;
  html+=`<div class="question">${item.q}</div>`;

  if(item.type==="input"){
    html+=`<input class="txt-input" id="ti" placeholder="Введи ответ…" autocomplete="off">
      <button class="check-btn" id="ck">Проверить ✓</button><div class="feedback" id="fb"></div>`;
    card.innerHTML=html;
    document.getElementById("ck").onclick=()=>{
      const v=norm(document.getElementById("ti").value); if(!v)return;
      const ok=item.a.some(x=>norm(x)===v);
      document.getElementById("ti").disabled=true;document.getElementById("ck").remove();
      award(document.getElementById("fb"),ok,item.show,item.fact||null,card);
      addNext(card);
    };
  } else if(item.type==="multi"){
    html+=`<div class="options">${item.o.map((o,i)=>`<button class="opt" data-i="${i}">${o}</button>`).join("")}</div>
      <button class="check-btn" id="ck">Проверить ✓</button><div class="feedback" id="fb"></div>`;
    card.innerHTML=html;
    const sel=new Set();
    card.querySelectorAll(".opt").forEach(b=>b.onclick=()=>{
      const i=+b.dataset.i;sel.has(i)?(sel.delete(i),b.classList.remove("sel")):(sel.add(i),b.classList.add("sel"));
    });
    document.getElementById("ck").onclick=()=>{
      const right=new Set(item.a);
      const ok=sel.size===right.size&&[...sel].every(x=>right.has(x));
      card.querySelectorAll(".opt").forEach(b=>{b.onclick=null;const i=+b.dataset.i;
        if(right.has(i))b.classList.add("correct"); else if(sel.has(i))b.classList.add("wrong");});
      document.getElementById("ck").remove();
      award(document.getElementById("fb"),ok,null,item.fact||null,card);
      addNext(card);
    };
  } else {
    html+=`<div class="options">${item.o.map((o,i)=>`<button class="opt" data-i="${i}">${o}</button>`).join("")}</div>
      <div class="feedback" id="fb"></div>`;
    card.innerHTML=html;
    card.querySelectorAll(".opt").forEach(btn=>btn.onclick=()=>{
      const i=+btn.dataset.i;card.querySelectorAll(".opt").forEach(b=>b.onclick=null);
      const ok=i===item.a;
      if(ok)btn.classList.add("correct");
      else{btn.classList.add("wrong");card.querySelectorAll(".opt")[item.a].classList.add("correct");}
      award(document.getElementById("fb"),ok,null,item.fact||null,card);
      addNext(card);
    });
  }
}

function renderResult(){
  const days=secDays(); const day=days[curDay];
  const total=day.questions.filter(q=>q.stage!=="rule").length;
  if(!ST.done.includes(day.idx)){
    ST.done.push(day.idx);
    const today=new Date().toDateString();
    if(ST.lastDate!==today){
      const yest=new Date(Date.now()-864e5).toDateString();
      ST.streak=(ST.lastDate===yest)?ST.streak+1:1;ST.lastDate=today;
    }
    save();
  }
  updHdr();renderDays();
  document.getElementById("prog").style.width="100%";
  const pct=Math.round((correct/Math.max(total,1))*100);
  const emoji=pct===100?"🏆":pct>=70?"⚡":"🌱";
  const msg=pct===100?"Идеально! Ты настоящий маг!":pct>=70?"Отличная работа!":"Практикуйся — и будет лучше!";
  document.getElementById("card").innerHTML=`
    <div class="big">${emoji}</div>
    <div class="result-text">${msg}</div>
    <div class="result-sub">Правильных ответов: ${correct} из ${total}</div>
    <div class="stars-row">${"⚡".repeat(Math.max(1,Math.min(correct,8)))}</div>
    <button class="next-btn" onclick="location.reload()">← К урокам</button>`;
}

updHdr();renderTabs();renderDays();renderQ();
</script>
</body>
</html>
