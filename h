<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Хогвартс · Русский язык</title>
<style>
/* ── ТОКЕНЫ ─────────────────────────────────────────── */
:root {
  --bg:       oklch(11% 0.015 265);
  --surface:  oklch(16% 0.018 265);
  --raised:   oklch(20% 0.02  265);
  --border:   oklch(28% 0.025 265);
  --text:     oklch(92% 0.008 265);
  --muted:    oklch(55% 0.015 265);

  --gold:     oklch(75% 0.16  72);
  --gold-dim: oklch(60% 0.14  72);
  --gold-bg:  oklch(22% 0.06  72);

  --purple:   oklch(62% 0.16 295);
  --purple-bg:oklch(18% 0.05 295);

  --ok:       oklch(62% 0.16 148);
  --ok-bg:    oklch(18% 0.06 148);
  --err:      oklch(60% 0.19  20);
  --err-bg:   oklch(18% 0.07  20);

  --r0: oklch(62% 0.18 295); /* Прорицания */
  --r1: oklch(60% 0.2   25); /* Зельеварение */
  --r2: oklch(60% 0.19 148); /* Трансфигурация */
  --r3: oklch(72% 0.16  72); /* Защита */
  --r4: oklch(58% 0.17 210); /* Заклинания */
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{
  font-family:-apple-system,"SF Pro Rounded","Segoe UI",sans-serif;
  background:var(--bg);
  min-height:100vh;
  display:flex;justify-content:center;
  padding:14px 12px 48px;
  background-image:
    radial-gradient(ellipse 60% 40% at 50% -10%, oklch(28% 0.08 280 / .35), transparent),
    radial-gradient(ellipse 40% 30% at 80% 110%, oklch(25% 0.07 50 / .2), transparent);
}
.app{width:100%;max-width:440px}

/* ── HEADER ─────────────────────────────────────────── */
.header{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:20px;
  padding:13px 16px;
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:12px;
  box-shadow:0 0 24px oklch(75% 0.16 72 / .08);
}
.header h1{font-size:16px;font-weight:800;color:var(--gold);letter-spacing:.03em}
.header h1 span{color:var(--text);font-weight:500}
.stats{display:flex;gap:8px}
.stat{
  background:var(--gold-bg);
  border:1px solid oklch(75% 0.16 72 / .3);
  border-radius:10px;
  padding:5px 10px;
  font-size:13px;font-weight:700;
  color:var(--gold);
}
.stat.streak{background:oklch(20% 0.06 25);border-color:oklch(60% 0.19 20 / .35);color:oklch(72% 0.18 35)}

/* ── ФАКУЛЬТЕТ-ВКЛАДКИ ─────────────────────────────── */
.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
.tab{
  border:1px solid var(--border);
  border-radius:20px;
  padding:6px 12px;
  font-size:12px;font-weight:700;
  cursor:pointer;
  background:var(--surface);
  color:var(--muted);
  transition:transform .12s,background .15s,color .15s,border-color .15s;
  white-space:nowrap;
}
.tab:active{transform:scale(.93)}
.tab[data-s="0"].active{background:oklch(20% 0.07 295);color:var(--r0);border-color:oklch(62% 0.18 295 / .5)}
.tab[data-s="1"].active{background:oklch(20% 0.07  25);color:var(--r1);border-color:oklch(60% 0.2   25 / .5)}
.tab[data-s="2"].active{background:oklch(18% 0.07 148);color:var(--r2);border-color:oklch(60% 0.19 148 / .5)}
.tab[data-s="3"].active{background:var(--gold-bg);    color:var(--r3);border-color:oklch(72% 0.16  72 / .5)}
.tab[data-s="4"].active{background:oklch(18% 0.06 210);color:var(--r4);border-color:oklch(58% 0.17 210 / .5)}

/* ── ДНИ ─────────────────────────────────────────────── */
.days{display:grid;grid-template-columns:repeat(5,1fr);gap:7px;margin-bottom:12px}
.day-btn{
  border:1px solid var(--border);
  border-radius:14px;
  padding:10px 2px;
  font-size:12.5px;font-weight:700;
  background:var(--surface);
  color:var(--muted);
  cursor:pointer;
  transition:transform .12s;
}
.day-btn:active{transform:scale(.9)}
.day-btn.done{background:var(--ok-bg);border-color:oklch(62% 0.16 148 / .4);color:var(--ok)}
.day-btn.active{border-color:var(--gold);color:var(--gold);background:var(--gold-bg)}

/* ── ПРОГРЕСС ────────────────────────────────────────── */
.prog-wrap{height:3px;background:var(--raised);border-radius:99px;margin-bottom:14px;overflow:hidden}
.prog-fill{height:100%;background:linear-gradient(90deg,var(--purple),var(--gold));border-radius:99px;transition:width .4s ease}

/* ── КАРТОЧКА ────────────────────────────────────────── */
.card{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:22px;
  padding:20px 18px;
  box-shadow:0 0 40px oklch(0% 0 0 / .4);
  animation:appear .28s ease;
}
@keyframes appear{from{transform:translateY(6px) scale(.98);opacity:0}to{transform:none;opacity:1}}

.mascot{font-size:34px;text-align:center;margin-bottom:4px;filter:drop-shadow(0 0 8px oklch(75% 0.16 72 / .5))}
.q-meta{text-align:center;font-size:11px;font-weight:700;color:var(--muted);margin-bottom:10px;letter-spacing:.04em;text-transform:uppercase}

/* ── ЭТАПЫ УРОКА ─────────────────────────────────────── */
.stage-badge{
  display:inline-flex;align-items:center;gap:5px;
  border-radius:8px;padding:3px 10px;
  font-size:11px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;
  margin-bottom:10px;
}
.stage-rule {background:oklch(20% 0.07 295);color:var(--r0);border:1px solid oklch(62% 0.18 295 / .4)}
.stage-practice{background:var(--gold-bg);color:var(--gold);border:1px solid oklch(75% 0.16 72 / .4)}
.stage-exception{background:oklch(20% 0.07 25);color:var(--r1);border:1px solid oklch(60% 0.2 25 / .4)}
.stage-olymp{background:oklch(18% 0.07 148);color:var(--r2);border:1px solid oklch(60% 0.19 148 / .4)}

/* ── СВИТОК (ПРАВИЛО) ────────────────────────────────── */
.scroll-box{
  background:oklch(13% 0.03 72);
  border:1px solid oklch(75% 0.16 72 / .25);
  border-radius:14px;
  padding:14px 16px;
  margin-bottom:14px;
  position:relative;
}
.scroll-box::before{
  content:'📜';
  position:absolute;top:-10px;left:14px;
  font-size:18px;
  filter:drop-shadow(0 0 6px oklch(75% 0.16 72 / .5));
}
.scroll-title{
  font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
  color:var(--gold-dim);margin-bottom:8px;padding-top:2px;
}
.scroll-body{
  font-size:13.5px;line-height:1.65;color:oklch(85% 0.02 72);
  white-space:pre-line;
}
.scroll-body strong{color:var(--gold);font-weight:700}
.scroll-body em{color:var(--r1);font-style:normal;font-weight:600}
.scroll-body code{
  font-family:ui-monospace,monospace;font-size:12.5px;
  background:oklch(20% 0.04 72);
  border:1px solid oklch(75% 0.16 72 / .2);
  border-radius:5px;padding:1px 5px;color:var(--gold);
}

/* ── КОНТЕКСТ (ОТРЫВОК) ─────────────────────────────── */
.ctx{
  background:var(--raised);
  border:1px solid var(--border);
  border-left:3px solid var(--purple);
  border-radius:12px;
  padding:11px 14px;
  font-size:13px;color:var(--text);
  line-height:1.6;white-space:pre-line;
  margin-bottom:14px;
  max-height:160px;overflow-y:auto;
}

/* ── ВОПРОС ─────────────────────────────────────────── */
.question{
  font-size:15.5px;font-weight:700;color:var(--text);
  margin-bottom:14px;line-height:1.5;
}

/* ── ВАРИАНТЫ ────────────────────────────────────────── */
.options{display:grid;gap:8px}
.opt{
  border:1px solid var(--border);
  background:var(--raised);
  border-radius:13px;
  padding:12px 14px;
  font-size:14px;font-weight:600;
  color:var(--text);cursor:pointer;text-align:left;
  transition:transform .1s,border-color .15s,background .15s;
  line-height:1.4;
}
.opt:hover{border-color:var(--purple);background:oklch(22% 0.04 295)}
.opt:active{transform:scale(.98)}
.opt.sel{border-color:var(--purple);background:var(--purple-bg)}
.opt.correct{background:var(--ok-bg);border-color:var(--ok);color:oklch(78% 0.14 148)}
.opt.wrong  {background:var(--err-bg);border-color:var(--err);color:oklch(78% 0.16 20)}

/* ── ВВОД ────────────────────────────────────────────── */
.txt-input{
  width:100%;
  background:var(--raised);
  border:1px solid var(--border);
  border-radius:13px;
  padding:13px 14px;
  font-size:15px;font-weight:600;
  color:var(--text);outline:none;
  transition:border-color .15s;
}
.txt-input:focus{border-color:var(--purple)}
.txt-input::placeholder{color:var(--muted);font-weight:400}

/* ── ФИДБЕК ──────────────────────────────────────────── */
.feedback{text-align:center;font-size:15px;font-weight:800;margin-top:11px;min-height:20px}
.hint-ans{text-align:center;font-size:12.5px;color:var(--muted);margin-top:4px}

/* ── ФАН-ФАКТ ────────────────────────────────────────── */
.fun-fact{
  background:oklch(15% 0.05 72);
  border:1px solid oklch(75% 0.16 72 / .2);
  border-left:3px solid var(--gold);
  border-radius:10px;
  padding:10px 12px;
  font-size:12.5px;color:oklch(78% 0.05 72);
  margin-top:10px;line-height:1.55;
}
.fun-fact::before{content:'⚡ ';color:var(--gold);font-weight:700}

/* ── КНОПКИ ──────────────────────────────────────────── */
.check-btn,.next-btn,.rule-btn{
  display:block;width:100%;
  margin-top:12px;
  border:none;border-radius:13px;
  padding:13px;
  font-size:15px;font-weight:800;
  color:oklch(12% 0.02 72);
  cursor:pointer;
  background:linear-gradient(135deg, var(--gold) 0%, oklch(68% 0.14 55) 100%);
  box-shadow:0 4px 16px oklch(75% 0.16 72 / .2);
  transition:transform .1s,box-shadow .15s;
}
.check-btn:active,.next-btn:active,.rule-btn:active{transform:scale(.98);box-shadow:none}
.rule-btn{background:linear-gradient(135deg,var(--purple),oklch(52% 0.14 285));color:#fff}

/* ── РЕЗУЛЬТАТ ───────────────────────────────────────── */
.big{font-size:52px;text-align:center;margin:8px 0;filter:drop-shadow(0 0 12px oklch(75% 0.16 72 / .6))}
.result-text{text-align:center;font-size:17px;font-weight:800;color:var(--text)}
.result-sub{text-align:center;font-size:13px;color:var(--muted);margin-top:6px}
.stars-row{text-align:center;font-size:24px;margin:10px 0}

/* ── ВСПЫШКА ПРАВИЛЬНОГО ОТВЕТА ─────────────────────── */
@keyframes flashGold{
  0%{box-shadow:0 0 0 0 oklch(75% 0.16 72 / .8)}
  70%{box-shadow:0 0 0 18px oklch(75% 0.16 72 / 0)}
  100%{box-shadow:none}
}
.flash-ok{animation:flashGold .5s ease-out}
@keyframes flashErr{
  0%{box-shadow:0 0 0 0 oklch(60% 0.19 20 / .7)}
  70%{box-shadow:0 0 0 14px oklch(60% 0.19 20 / 0)}
  100%{box-shadow:none}
}
.flash-err{animation:flashErr .4s ease-out}

/* ── СКРОЛЛ ──────────────────────────────────────────── */
::-webkit-scrollbar{width:4px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:99px}
</style>
</head>
<body>
<div class="app">

  <div class="header">
    <h1>⚡ Хогвартс <span>· Русский</span></h1>
    <div class="stats">
      <div class="stat">⚡ <span id="stars">0</span></div>
      <div class="stat streak">🔥 <span id="streak">0</span></div>
    </div>
  </div>

  <div class="tabs" id="tabs"></div>
  <div class="prog-wrap"><div class="prog-fill" id="prog" style="width:0%"></div></div>
  <div class="days" id="days"></div>
  <div class="card" id="card"></div>

</div>
<script>
/* ═══════════════════════════════════════════════════════
   ДАННЫЕ: РАЗДЕЛЫ
═══════════════════════════════════════════════════════ */
const SEC = [
  {name:"🔮 Прорицания",    color:"var(--r0)", emoji:"🔮"},  // Этимология
  {name:"⚗️ Зельеварение",  color:"var(--r1)", emoji:"⚗️"},  // Орфография
  {name:"✨ Трансфигурация",color:"var(--r2)", emoji:"✨"},   // Морфология
  {name:"🛡️ Защита",        color:"var(--r3)", emoji:"🛡️"},  // Лексика
  {name:"⚡ Заклинания",    color:"var(--r4)", emoji:"🎵"},  // Фонетика
];

/* ═══════════════════════════════════════════════════════
   ДАННЫЕ: ДНИ
   Каждый день = один урок.
   Структура урока: rule → practice (базовые) → exception → olymp
   Этапы: "rule" | "practice" | "exception" | "olymp"
═══════════════════════════════════════════════════════ */
const DAYS = [

/* ━━━━━━ РАЗДЕЛ 0: ПРОРИЦАНИЯ (Этимология) ━━━━━━━━━━━ */
{
  sec:0, title:"Урок 1 · Ложные родственники",
  questions:[
    // ── ПРАВИЛО ──────────────────────────────────────
    {stage:"rule", q:"📜 ПРАВИЛО\n\nПохожие слова — не всегда родственники!\n«Ложные родственники» похожи по звуку, но их корни разные. Чтобы проверить родство, нужно понять исходное значение.\n\nПример: <strong>бедро</strong> и <strong>беда</strong> — похоже, но корни разные! «Бедро» от праслав. *bedro (часть тела), «беда» от *beda (нужда).\n\nПравило: если смысл корней совсем разный — слова НЕ родственники, даже если звучат похоже.", type:"rule"},

    // ── ПРАКТИКА: базовые ────────────────────────────
    {stage:"practice",
     q:"Какое слово НЕ является однокоренным с остальными в ряду?\nбеда — бедность — победа — бедро",
     type:"mc", o:["беда","бедность","победа","бедро"], a:3,
     fact:"«Бедро» — от *bedro (ляжка). Совсем другое значение! «Беда», «бедность», «победа» — от *beda (нужда, горе). Это классическая ловушка олимпиады."},

    {stage:"practice",
     q:"В ряду «питьё — пир — пиявка — пища» найдите слово, НЕ однокоренное с остальными.",
     type:"mc", o:["питьё","пир","пиявка","пища"], a:3,
     fact:"«Пища» — от *pitati (кормить), корень иной. Питьё, пир (пиршество), пиявка — все от *piti (пить). Пиявка буквально «то, что пьёт»."},

    // ── ИСКЛЮЧЕНИЯ/СЛОЖНЫЕ ───────────────────────────
    {stage:"exception",
     q:"В ряду «знамя — зной — знак — знание» найдите лишнее слово.",
     type:"mc", o:["знамя","зной","знак","знание"], a:1,
     fact:"«Зной» — от *znojь (жар), связан с «жечь». А «знамя», «знак», «знание» — от *znati (знать). Зной — «ложный друг», хотя начинается на «зн-»!"},

    {stage:"exception",
     q:"В ряду «басня — баюкать — байк — баян» найдите лишнее слово.",
     type:"mc", o:["басня","баюкать","байк","баян"], a:2,
     fact:"«Байк» (bike) — английское слово. «Басня», «баюкать», «баян» — от корня *баj- (говорить нараспев, петь). Баян — инструмент певца!"},

    // ── ОЛИМПИАДНОЕ ЗАДАНИЕ ───────────────────────────
    {stage:"olymp",
     ctx:"Задание из олимпиады «Ломоносов»\n\nНайдите в каждом ряду лишнее слово по одному и тому же принципу.",
     q:"В ряду «роется — рой — выроет» — все ли слова однокоренные?",
     type:"mc", o:["Да, все однокоренные (корень -рой-/-ры-)","Нет, «рой» — существительное, поэтому лишнее","Нет, «рой» от другого корня — значит «туча пчёл»","Нет, «выроет» лишнее — там приставка"], a:0,
     fact:"Все три — однокоренные: корень -рой-/-ры- (рыть). «Рой» пчёл — омоним, другое слово! В данном ряду все слова от «рыть»."},
  ]
},

{
  sec:0, title:"Урок 2 · Исторические родственники",
  questions:[
    // ── ПРАВИЛО ──────────────────────────────────────
    {stage:"rule", q:"📜 ПРАВИЛО\n\nИсторические родственники — слова с общим древним корнем, которые в современном языке выглядят совсем разными.\n\nПример: <strong>пытаться</strong> и <strong>опыт</strong> — оба от корня *pyt- (испытывать). Сейчас родство не чувствуется!\n\nЕщё пример: <strong>наконец</strong> и <strong>закончился</strong> — корень -кон- (предел, граница).\n\nКак найти: ищи общий смысл в глубине, не на поверхности.", type:"rule"},

    {stage:"practice",
     q:"«Пытались» и «опыт» — исторически родственные слова. Что их объединяет?",
     type:"mc",
     o:["Оба обозначают неудачу","Оба от корня *pyt- (испытывать, пробовать)","Оба пришли из латыни","Оба заимствованы из польского"],
     a:1,
     fact:"Корень *pyt- — испытывать. Пытаться = делать попытку. Опыт = результат испытания. В современном языке родство стёрлось."},

    {stage:"practice",
     q:"«Наконец» и «закончившуюся» — исторические родственники. Какой корень их объединяет?",
     type:"mc", o:["-кон-","-нач-","-нец-","-конец-"], a:0,
     fact:"Корень -кон- = предел, граница. НаКОНец, заКОНчить, НАчало (от кона = начала), оКОНчание, поЧАток, заЧИН — все родственники через этот корень!"},

    {stage:"exception",
     q:"«Броня» и «бранный» (бранное поле) — исторические родственники. Что значило «брань» в Древней Руси?",
     type:"mc",
     o:["Ругань, ссора","Война, битва","Одежда воина","Вид оружия"],
     a:1,
     fact:"В древнерусском «брань» = война, битва. Позже значение сузилось до «ругань». Поэтому «бранное поле» = поле битвы. «Броня» — тоже родственник: защита в бою!"},

    {stage:"olymp",
     ctx:"Задание из Всероссийской олимпиады 2023/24\n\nПрочитайте предложения:\n1) Путешественники несколько раз пытались переправиться через реку на плотах...\n2) ...приобретают опыт общения со сверстниками...",
     q:"Найдите в текстах глагол и существительное, которые являются историческими родственниками, но НЕ родственными в современном языке.",
     type:"mc",
     o:["переправиться — плот","пытались — опыт","переправиться — опыт","пытались — реку"],
     a:1,
     fact:"Пытались (глагол) + опыт (существительное) — оба от *pyt- (испытывать). В современном языке связь не ощущается — это и есть «исторические родственники»."},
  ]
},

/* ━━━━━━ РАЗДЕЛ 1: ЗЕЛЬЕВАРЕНИЕ (Орфография) ━━━━━━━━━ */
{
  sec:1, title:"Урок 3 · Суффиксы -е/-и/-ин-",
  questions:[
